rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validBook(data) {
      return data.title is string
        && data.title.size() > 0 && data.title.size() <= 300
        && data.status in ['wantToRead', 'reading', 'finished']
        && (data.rating == null || (data.rating is int && data.rating >= 1 && data.rating <= 5))
        && (data.note == null || (data.note is string && data.note.size() <= 5000));
    }

    // Профиль пользователя (FCM-токены и т.п.) — только владелец
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Книги пользователя — только владелец, с валидацией полей
      match /books/{bookId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validBook(request.resource.data);
      }
    }

    // Всё остальное запрещено
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
